# Fantech Aria XD7 (Compx / Areson, VID 0x25a7) — allow the logged-in user
# to open the hidraw nodes so WebHID (Chrome/Edge/Brave/Opera) can configure
# the mouse. Covers wired, 2.4G dongle and Bluetooth (PID fa7b / fa7c / ...).
KERNEL=="hidraw*", ATTRS{idVendor}=="25a7", MODE="0660", TAG+="uaccess"
# Bluetooth / non-USB path: match on the HID id instead of USB attrs
KERNEL=="hidraw*", KERNELS=="*:25A7:*", MODE="0660", TAG+="uaccess"
